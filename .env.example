# Copy to .env and adjust. `make up` does this automatically if .env is missing.

# ---- Core ----
NODE_ENV=development
API_PORT=8787
WEB_PORT=5173
LANDING_PORT=4321
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# ---- Postgres (docker-compose maps 5432 -> 5433 to avoid clashing with a local pg) ----
DATABASE_URL=postgres://poddex:poddex@localhost:5433/poddex

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6380

# ---- Object storage (MinIO locally, Cloudflare R2 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=poddex-media
S3_ACCESS_KEY_ID=poddex
S3_SECRET_ACCESS_KEY=poddex-secret
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=524288000

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=dev-secret-change-me-in-production-0123456789
BETTER_AUTH_URL=http://localhost:8787
# Leave Google creds blank locally to use the dev email/password sign-in instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Transcription ----
# Blank => fake transcript provider (no network, deterministic). Set to use Deepgram Nova.
DEEPGRAM_API_KEY=

# ---- LLM generation ----
# Blank => fake generator (no network, deterministic). Set to use OpenRouter.
OPENROUTER_API_KEY=
LLM_FAST_MODEL=anthropic/claude-haiku-4.5
LLM_SMART_MODEL=anthropic/claude-sonnet-5

# ---- Billing (Stripe) ----
# Blank => stub checkout that simulates a completed payment locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LTD=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=

# ---- Email (Mailhog locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=pod-dex <noreply@pod-dex.local>
